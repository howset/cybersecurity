#!/usr/bin/env python3
import argparse
import os
import sys
from html.parser import HTMLParser
from urllib.error import URLError, HTTPError
from urllib.parse import urljoin, urlparse, urldefrag, unquote
from urllib.request import Request, urlopen

EXTENSIONS = (".jpg", ".jpeg", ".png", ".gif", ".bmp")
DEFAULT_DEPTH = 5
TIMEOUT = 10
HEADERS = {"User-Agent": "Mozilla/5.0 (spider)"}


class PageParser(HTMLParser):
    """Collects image URLs (<img>) and links (<a href>) from an HTML page."""

    def __init__(self):
        super().__init__()
        self.images = []
        self.links = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "img":
            for key in ("src", "data-src"):
                if attrs.get(key):
                    self.images.append(attrs[key])
            if attrs.get("srcset"):
                for part in attrs["srcset"].split(","):
                    part = part.strip().split(" ")[0]
                    if part:
                        self.images.append(part)
        elif tag == "a" and attrs.get("href"):
            self.links.append(attrs["href"])


def fetch(url):
    req = Request(url, headers=HEADERS)
    return urlopen(req, timeout=TIMEOUT)


def get_page(url):
    """Return (html, final_url) or (None, url) on failure / non-HTML."""
    try:
        with fetch(url) as resp:
            ctype = resp.headers.get("Content-Type", "")
            if "html" not in ctype.lower():
                return None, url
            charset = resp.headers.get_content_charset() or "utf-8"
            return resp.read().decode(charset, errors="replace"), resp.geturl()
    except (HTTPError, URLError, ValueError, TimeoutError) as e:
        print(f"[!] cannot open {url}: {e}", file=sys.stderr)
        return None, url


def is_image(url):
    return urlparse(url).path.lower().endswith(EXTENSIONS)


def unique_path(folder, name):
    path = os.path.join(folder, name)
    base, ext = os.path.splitext(name)
    i = 1
    while os.path.exists(path):
        path = os.path.join(folder, f"{base}_{i}{ext}")
        i += 1
    return path


def download_image(url, folder):
    name = os.path.basename(unquote(urlparse(url).path)) or "image"
    try:
        with fetch(url) as resp:
            data = resp.read()
    except (HTTPError, URLError, ValueError, TimeoutError) as e:
        print(f"[!] cannot download {url}: {e}", file=sys.stderr)
        return
    path = unique_path(folder, name)
    with open(path, "wb") as f:
        f.write(data)
    print(f"[+] {url} -> {path}")


def crawl(start_url, recursive, max_depth, folder):
    host = urlparse(start_url).netloc
    visited_pages = set()
    seen_images = set()
    queue = [(start_url, 0)]

    while queue:
        url, depth = queue.pop(0)
        if url in visited_pages:
            continue
        visited_pages.add(url)

        html, final_url = get_page(url)
        if html is None:
            continue
        print(f"[*] (depth {depth}) {url}")

        parser = PageParser()
        parser.feed(html)

        for src in parser.images:
            if src.startswith("data:"):
                continue
            img_url = urldefrag(urljoin(final_url, src))[0]
            if is_image(img_url) and img_url not in seen_images:
                seen_images.add(img_url)
                download_image(img_url, folder)

        if recursive and depth < max_depth:
            for href in parser.links:
                link = urldefrag(urljoin(final_url, href))[0]
                p = urlparse(link)
                if p.scheme not in ("http", "https"):
                    continue
                if p.netloc != host:  # stay on the same site
                    continue
                if link not in visited_pages:
                    queue.append((link, depth + 1))

    print(f"Done: {len(seen_images)} image(s), {len(visited_pages)} page(s) visited.")


def spider_dl():
    parser = argparse.ArgumentParser(
        prog="./spider",
        description="download images from URL."
    )
    parser.add_argument(
        "-r",
        action="store_true",
        help="recursive download"
    )
    parser.add_argument(
        "-l",
        type=int,
        metavar="N",
        default=None,
        help=f"depth limit (default: {DEFAULT_DEPTH}; requires -r)"
    )
    parser.add_argument(
        "-p",
        default="./data/",
        metavar="PATH",
        help="download path (default: ./data/)"
    )
    parser.add_argument("url", help="URL to download images from")

    args = parser.parse_args()

    if args.l is not None and not args.r:
        parser.error("-l requires -r")
    if args.l is not None and args.l < 0:
        parser.error("-l must be >= 0")
    depth = args.l if args.l is not None else DEFAULT_DEPTH

    if urlparse(args.url).scheme not in ("http", "https"):
        parser.error("url must start with http:// or https://")

    os.makedirs(args.p, exist_ok=True)
    crawl(args.url, args.r, depth, args.p)


if __name__ == "__main__":
    try:
        spider_dl()
    except KeyboardInterrupt:
        sys.exit(130)
